# Sao chép thành .env rồi chỉnh nếu cần. KHÔNG commit file .env.
PORT=3000
DATABASE_FILE=./data/khao-sat.db

# Khóa ký token đăng nhập. Giá trị dưới đây chỉ dùng cho máy học tập;
# môi trường thật phải sinh khóa riêng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=khoa-ky-token-cho-moi-truong-hoc-tap-doi-lai-truoc-khi-dung-that
TOKEN_TTL_HOURS=8

# Mật khẩu của 4 tài khoản demo do "npm run seed" tạo ra (quanly.tt01 / bgd / marketing / hethong)
DEMO_PASSWORD=Demo@2026
